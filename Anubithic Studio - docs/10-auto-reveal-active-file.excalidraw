      "link": null,
      "locked": false,
      "text": "\"revealFolders: (projectId, folderIds[]) => void;\"\n\n// Expand a chain of folders at once (root header -> folders -> ... -> direct\nparent of the active file). \n\n// Never collapses anything: folders the useropened by hand stay open. \nThis is the core of the \"reveal active file\"\n\n// behavior - it also opens the explorer root so the chain is visible.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"revealFolders: (projectId, folderIds[]) => void;\"\n\n// Expand a chain of folders at once (root header -> folders -> ... -> direct\nparent of the active file). \n\n// Never collapses anything: folders the useropened by hand stay open. \nThis is the core of the \"reveal active file\"\n\n// behavior - it also opens the explorer root so the chain is visible.",
      "autoResize": true,
      "lineHeight": 1.25
    },
