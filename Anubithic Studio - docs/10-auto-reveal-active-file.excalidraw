      "text": "\"isFolderExpanded: (projectId, folderId) \" \n\n // Check whether one folder is currently expanded in a project.\n // Meant to be used as a Zustand selector:\n // useEditorStore((s) => s.isFolderExpanded(projectId, folderId))\n // so the component re-renders when this folder's expansion changes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"isFolderExpanded: (projectId, folderId) \" \n\n // Check whether one folder is currently expanded in a project.\n // Meant to be used as a Zustand selector:\n // useEditorStore((s) => s.isFolderExpanded(projectId, folderId))\n // so the component re-renders when this folder's expansion changes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
