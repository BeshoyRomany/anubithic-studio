    {
      "id": "xa-2HAz_OWQE6NRwNG9bp",
      "type": "text",
      "x": 754.0836852809242,
      "y": 665.1009431816279,
      "width": 881.439208984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1o",
      "roundness": null,
      "seed": 1711702863,
      "version": 18,
      "versionNonce": 94904353,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789218060128,
      "link": null,
      "locked": false,
      "text": " \"Configures Cross-Origin-Opener-Policy (COOP) and Cross-Origin-Embedder-Policy (COEP) \n headers to enable SharedArrayBuffer required for WebContainers to run.\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " \"Configures Cross-Origin-Opener-Policy (COOP) and Cross-Origin-Embedder-Policy (COEP) \n headers to enable SharedArrayBuffer required for WebContainers to run.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "L_UwvLVYZ_jrLQ_gifb_z",
      "type": "text",
      "x": 752.6551138523527,
      "y": 758.243752368291,
      "width": 1006.2392578125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1oV",
      "roundness": null,
      "seed": 1301448527,
      "version": 71,
      "versionNonce": 1453370945,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789218071505,
      "link": null,
      "locked": false,
      "text": "WHY WE NEED THIS:\nBrowsers block WebContainers for security reasons unless the page is cross-origin isolated.\nThese security headers unlock the SharedArrayBuffer feature required for the browser to run Node.js.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHY WE NEED THIS:\nBrowsers block WebContainers for security reasons unless the page is cross-origin isolated.\nThese security headers unlock the SharedArrayBuffer feature required for the browser to run Node.js.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GCfjHY2bP0djc16h_t545",
      "type": "text",
      "x": 756.3694082859465,
      "y": 865.1009213833578,
      "width": 923.1593627929688,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 964345231,
      "version": 25,
      "versionNonce": 1663058017,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789218083495,
      "link": null,
      "locked": false,
      "text": "SharedArrayBuffer: \nA shared memory buffer that allows multiple threads to read and write \nto the same memory space simultaneously, which WebContainers need to run Node.js efficiently.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SharedArrayBuffer: \nA shared memory buffer that allows multiple threads to read and write \nto the same memory space simultaneously, which WebContainers need to run Node.js efficiently.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uXPjcruteBo-xje_59mE0",
      "type": "text",
      "x": 740.5122305515713,
      "y": 1198.0056469576693,
      "width": 345.459716796875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 779386337,
      "version": 172,
      "versionNonce": 641632686,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789376608584,
      "link": null,
      "locked": false,
      "text": "key: \"Cross-Origin-Embedder-Policy\",\nvalue: \"credentialless\",",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "key: \"Cross-Origin-Embedder-Policy\",\nvalue: \"credentialless\",",
