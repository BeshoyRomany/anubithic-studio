      "seed": 1966072514,
      "version": 740,
      "versionNonce": 1472426974,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789746405934,
      "link": null,
      "locked": false,
      "text": "What are GitHub Scopes?\n\nGitHub Scopes are specific permissions that you grant to an application (via OAuth).\nThey control what the application can see or do on your GitHub account\n(e.g., reading public data, writing code, or accessing private repositories).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What are GitHub Scopes?\n\nGitHub Scopes are specific permissions that you grant to an application (via OAuth).\nThey control what the application can see or do on your GitHub account\n(e.g., reading public data, writing code, or accessing private repositories).",
      "autoResize": true,
      "lineHeight": 1.25
    },
