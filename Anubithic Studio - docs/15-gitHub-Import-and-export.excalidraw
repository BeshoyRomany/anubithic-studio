      "roundness": null,
      "seed": 1962504350,
      "version": 231,
      "versionNonce": 1659020766,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789736901568,
      "link": null,
      "locked": false,
      "text": "1- Custom Credentials (The Official Contract): Registering an application on GitHub and adding its credentials to Clerk \nacts like signing an official contract, allowing Anubithic Studio to officially interact with GitHub APIs.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- Custom Credentials (The Official Contract): Registering an application on GitHub and adding its credentials to Clerk \nacts like signing an official contract, allowing Anubithic Studio to officially interact with GitHub APIs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EiORy0tmT1FBf_ONjGkrZ",
      "type": "text",
      "x": 757.2107923837885,
      "y": 581.6830277811409,
      "width": 780.4993896484375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2K",
      "roundness": null,
      "seed": 217597150,
      "version": 250,
      "versionNonce": 1118561410,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789735742973,
      "link": null,
      "locked": false,
      "text": "2- then enable -> \"Use custom credentials\" to grant access to the private reps.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2- then enable -> \"Use custom credentials\" to grant access to the private reps.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gugtAsXSjNyhnFbDAyjzn",
      "type": "text",
      "x": 752.9859323373292,
      "y": 822.9247398393595,
      "width": 885.79931640625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2KG",
      "roundness": null,
      "seed": 101314626,
      "version": 523,
      "versionNonce": 1657390814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789736909436,
      "link": null,
      "locked": false,
      "text": "2- User Consent & Access Token: When a user wants to import their private repositories, \nGitHub displays an OAuth consent screen asking for their permission. Once approved, \nAnubithic Studio securely captures the user's GitHub Access Token.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2- User Consent & Access Token: When a user wants to import their private repositories, \nGitHub displays an OAuth consent screen asking for their permission. Once approved, \nAnubithic Studio securely captures the user's GitHub Access Token.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WM_50RQOTwXVusi-mCI43",
      "type": "text",
      "x": 753.2894207857627,
      "y": 919.2281125585189,
      "width": 1098.979248046875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2KO",
      "roundness": null,
      "seed": 646895682,
      "version": 626,
      "versionNonce": 1912155522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789736994935,
      "link": null,
      "locked": false,
      "text": "3- Octokit Integration: The captured user token is then passed to octokit (the official GitHub SDK), \nenabling the application to seamlessly and securely fetch the user's private and public repositories into the IDE.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- Octokit Integration: The captured user token is then passed to octokit (the official GitHub SDK), \nenabling the application to seamlessly and securely fetch the user's private and public repositories into the IDE.",
      "autoResize": true,
      "lineHeight": 1.25
    },
