    {
      "id": "QPA9OslLS_sUB-QeyjzC-",
      "type": "text",
      "x": 740.336178229818,
      "y": 1513.4351152928257,
      "width": 827.239501953125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
