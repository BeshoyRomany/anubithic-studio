      "updated": 1789735014806,
      "link": null,
      "locked": false,
      "text": "Octokit: \nOfficial GitHub SDK to interact with repositories, issues, and Git APIs easily.\n\nisbinaryfile: \nUtility to check if a file contains binary data (like images) or plain text.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Octokit: \nOfficial GitHub SDK to interact with repositories, issues, and Git APIs easily.\n\nisbinaryfile: \nUtility to check if a file contains binary data (like images) or plain text.",
      "autoResize": true,
      "lineHeight": 1.25
    },
