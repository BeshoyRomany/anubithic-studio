    {
      "id": "c0AUhsKQxQZhyTfRxWqro",
      "type": "text",
      "x": 792.5923419097905,
      "y": 845.45057293474,
      "width": 1161.4791259765625,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
