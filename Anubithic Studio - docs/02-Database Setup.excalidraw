      "seed": 1672908080,
      "version": 1065,
      "versionNonce": 967892784,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786109464208,
      "link": null,
      "locked": false,
      "text": "define tables -> example\n\"projects\" table\n\n        a- will hold the projects [name, ownerId, importStatus, etc...]\n        b- \"importStatus\" is a field related to github when we import projects\n    - add index to the table for faster queries\n    - create (projects.ts) the table functions & backend in /convex root\n        -- create the function apis like: get, create etc...\n        -- then -> mutate & create from the clinet side and the result will sync automatically without any \"invalidations\"\n       ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "define tables -> example\n\"projects\" table\n\n        a- will hold the projects [name, ownerId, importStatus, etc...]\n        b- \"importStatus\" is a field related to github when we import projects\n    - add index to the table for faster queries\n    - create (projects.ts) the table functions & backend in /convex root\n        -- create the function apis like: get, create etc...\n        -- then -> mutate & create from the clinet side and the result will sync automatically without any \"invalidations\"\n       ",
      "autoResize": true,
      "lineHeight": 1.25
    },
