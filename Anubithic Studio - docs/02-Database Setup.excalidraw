      "link": null,
      "locked": false,
      "text": "\"Convex is a cloud database and backend platform that lets you write JavaScript functions \nto store data and automatically sync it across clients in real-time, \nwithout dealing with servers, web sockets, or cache management\".",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Convex is a cloud database and backend platform that lets you write JavaScript functions \nto store data and automatically sync it across clients in real-time, \nwithout dealing with servers, web sockets, or cache management\".",
      "autoResize": true,
      "lineHeight": 1.25
