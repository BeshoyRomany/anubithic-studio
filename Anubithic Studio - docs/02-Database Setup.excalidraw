    {
      "id": "D2Ywb1MUuwpX3s51ozNpA",
      "type": "text",
      "x": 752.0517594648579,
      "y": 155.95062294965948,
      "width": 828.9395751953125,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 1719714131,
      "version": 1059,
      "versionNonce": 1089398144,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786125128665,
      "link": null,
      "locked": false,
      "text": "1- got to convex.dev\n2- create an account and sign in \n3- install convex sdk in th project\n4- install convex propmt you to login and choose exiting project\n    and it will create the /convex [folder] in the project root to write your back end\n    and it will create the config -> /home/beshoyromany/.convex/config.json\n5- create a simple data in the root of the app to try\n    then Use the import command to add a tasks table \n    with the sample data into your Convex database.\n\n\n6- Expose a database query (fetch data) from the db -> create \"convex/tasks.ts\"\n7- Create a client component for the Convex provider \"ConvexClientProvider.tsx\"\n8- Wire up the ConvexClientProvider to the app -> layout.tsx\n9- Display the data in your app -> page.tsx\n10- run the app npm run dev\n\nNOTE: Keep two terminals running \"npm run dev\" & \"npm convex dev\"\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- got to convex.dev\n2- create an account and sign in \n3- install convex sdk in th project\n4- install convex propmt you to login and choose exiting project\n    and it will create the /convex [folder] in the project root to write your back end\n    and it will create the config -> /home/beshoyromany/.convex/config.json\n5- create a simple data in the root of the app to try\n    then Use the import command to add a tasks table \n    with the sample data into your Convex database.\n\n\n6- Expose a database query (fetch data) from the db -> create \"convex/tasks.ts\"\n7- Create a client component for the Convex provider \"ConvexClientProvider.tsx\"\n8- Wire up the ConvexClientProvider to the app -> layout.tsx\n9- Display the data in your app -> page.tsx\n10- run the app npm run dev\n\nNOTE: Keep two terminals running \"npm run dev\" & \"npm convex dev\"\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
