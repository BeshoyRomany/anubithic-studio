      "boundElements": null,
      "updated": 1788425782054,
      "link": null,
      "locked": false,
      "text": "Create inngest processMessage() to manage the background job that triggered from the \"message route.ts\" to manage the event\n\"message/sent\", failure statues, cancel status and retrive the \"assistant AI Response\" to update the message in the database\nthrough the \"system.ts\" api functions. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Create inngest processMessage() to manage the background job that triggered from the \"message route.ts\" to manage the event\n\"message/sent\", failure statues, cancel status and retrive the \"assistant AI Response\" to update the message in the database\nthrough the \"system.ts\" api functions. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
