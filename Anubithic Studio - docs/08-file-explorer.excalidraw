      "updated": 1786815739760,
      "link": null,
      "locked": false,
      "text": "define table (files) in the schema for folder/files\n\n    -folders & files properties (name, type, project, etc..)\n\n    -Add relation between --- files & projects tables----\n\n    -Add indexs (by_project), (by_parent) & (by_project_parent)\n\n        - // Index to fetch all files and roots belonging to a specific project\n        - // Index to fetch contents of a specific folder (files where parentId matches)\n        - // Composite index to query files filtered by both project and parent folder for fast hierarchical lookups",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "define table (files) in the schema for folder/files\n\n    -folders & files properties (name, type, project, etc..)\n\n    -Add relation between --- files & projects tables----\n\n    -Add indexs (by_project), (by_parent) & (by_project_parent)\n\n        - // Index to fetch all files and roots belonging to a specific project\n        - // Index to fetch contents of a specific folder (files where parentId matches)\n        - // Composite index to query files filtered by both project and parent folder for fast hierarchical lookups",
      "autoResize": false,
      "lineHeight": 1.25
    },
