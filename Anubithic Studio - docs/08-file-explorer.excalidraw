    {
      "id": "EJx4NtT1wUKJgjQroXtb8",
      "type": "text",
      "x": 1013.1560391044787,
      "y": 5675.618529373315,
      "width": 767.95947265625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2n",
      "roundness": null,
      "seed": 932575416,
      "version": 28,
      "versionNonce": 1873615032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787131688750,
      "link": null,
      "locked": false,
      "text": " 1. MEMORY & SCOPE ISOLATION: \n    Each Tree instance holds its own 'level' value independently in memory.\n    (Level 0 -> Level 1 -> Level 2 -> Level 3, etc.)\n \n 2. RIGHT-CLICK ACTION:\n    When you right-click a folder at Level 3, its specific instance knows its ID \n    and its current level (3) via its own scope.\n \n 3. PASSING THE NEXT LEVEL:\n    When creating inside it, we explicitly pass (level + 1) to the CreateInput \n    and any sub-items, making the new folder correctly render at Level 4.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " 1. MEMORY & SCOPE ISOLATION: \n    Each Tree instance holds its own 'level' value independently in memory.\n    (Level 0 -> Level 1 -> Level 2 -> Level 3, etc.)\n \n 2. RIGHT-CLICK ACTION:\n    When you right-click a folder at Level 3, its specific instance knows its ID \n    and its current level (3) via its own scope.\n \n 3. PASSING THE NEXT LEVEL:\n    When creating inside it, we explicitly pass (level + 1) to the CreateInput \n    and any sub-items, making the new folder correctly render at Level 4.",
      "autoResize": true,
      "lineHeight": 1.25
    }
