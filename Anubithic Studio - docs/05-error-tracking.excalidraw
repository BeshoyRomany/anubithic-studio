      "isDeleted": false,
      "boundElements": [],
      "updated": 1786433286347,
      "link": null,
      "locked": false,
      "text": "\"Automatically captures and traces AI operations, spans, and token flows for Vercel AI SDK,\nallowing you to monitor how much tokens we sepnt, prompt performance \nand troubleshoot LLM errors directly in Sentry.\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Automatically captures and traces AI operations, spans, and token flows for Vercel AI SDK,\nallowing you to monitor how much tokens we sepnt, prompt performance \nand troubleshoot LLM errors directly in Sentry.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
