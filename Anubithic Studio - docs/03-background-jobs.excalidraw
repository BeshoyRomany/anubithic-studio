    {
      "id": "ATsJriHwPkGwaFKdndqmM",
      "type": "text",
      "x": 747.8009463495086,
      "y": 455.74282054686694,
      "width": 875.1394653320312,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
