      "updated": 1786195292866,
      "link": null,
      "locked": false,
      "text": "1-Install mkcert and local CA (one-time setup for your machine):",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1-Install mkcert and local CA (one-time setup for your machine):",
