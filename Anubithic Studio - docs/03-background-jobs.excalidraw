      "isDeleted": false,
      "boundElements": [],
      "updated": 1786195292866,
      "link": null,
      "locked": false,
      "text": "5-Run the Inngest CLI to Sync with the Secure URL:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5-Run the Inngest CLI to Sync with the Secure URL:",
