      "isDeleted": false,
      "boundElements": [],
      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "1- Define Effect: Create setSuggestionEffect using StateEffect.define<string | null>() \nto act as a messenger for passing new AI suggestions.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- Define Effect: Create setSuggestionEffect using StateEffect.define<string | null>() \nto act as a messenger for passing new AI suggestions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lPYG8ylrHr8BH5HEg9Gqt",
      "type": "text",
      "x": 785.9402853434635,
      "y": 1548.8010396118707,
      "width": 508.23956298828125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
