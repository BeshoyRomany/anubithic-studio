      "seed": 1371830388,
      "version": 325,
      "versionNonce": 2124510540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "1- Define Effect: Create setSuggestionEffect\nusing StateEffect.define<string | null>() to \nact as a messenger for passing new AI suggestions.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- Define Effect: Create setSuggestionEffect\nusing StateEffect.define<string | null>() to \nact as a messenger for passing new AI suggestions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "22llEI08WdcWXkGgNJmeu",
      "type": "text",
      "x": 783.3402487223698,
      "y": 2650.4010762329644,
      "width": 864.659423828125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jd",
      "roundness": null,
      "seed": 2006347468,
      "version": 478,
      "versionNonce": 803007436,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "1- Capture Tab Event: Listen for the Tab keypress using CodeMirror's keymap extension.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- Capture Tab Event: Listen for the Tab keypress using CodeMirror's keymap extension.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "W_hqYJGp2nDeUlWYb43Sn",
      "type": "text",
      "x": 778.6739075765365,
      "y": 3504.401091491754,
      "width": 889.2793579101562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jf",
      "roundness": null,
      "seed": 1328665859,
      "version": 585,
      "versionNonce": 513726061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787849974833,
      "link": null,
      "locked": false,
      "text": "1- update(update: ViewUpdate): Listens strictly to document changes (docChanged)\n to prevent redundant requests caused by cursor movements, arrow keys, or mouse clicks.  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- update(update: ViewUpdate): Listens strictly to document changes (docChanged)\n to prevent redundant requests caused by cursor movements, arrow keys, or mouse clicks.  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XDr-Nd3XAe5PvEOm7051H",
      "type": "text",
      "x": 787.589015952017,
      "y": 4499.211201518385,
      "width": 826.2193603515625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jfV",
      "roundness": null,
      "seed": 2035375117,
      "version": 711,
      "versionNonce": 1223542275,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787850412387,
      "link": null,
      "locked": false,
      "text": "1- Active Suggestion Dismissal: If a suggestion is currently visible, \npressing Escape clears the suggestion state and flags the current line as dismissed \n(isSuggestionDismissedForLine = true) to block further auto-triggers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- Active Suggestion Dismissal: If a suggestion is currently visible, \npressing Escape clears the suggestion state and flags the current line as dismissed \n(isSuggestionDismissedForLine = true) to block further auto-triggers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tW-EocYMtqEBmiVoY5VVR",
      "type": "text",
      "x": 787.1007369094368,
      "y": 4620.9652757530275,
      "width": 839.9794921875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jfl",
      "roundness": null,
      "seed": 346261613,
      "version": 764,
      "versionNonce": 1911619309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787850452992,
      "link": null,
      "locked": false,
      "text": "2- Dismissal State Toggle: If no suggestion is present but the line is already marked \nas dismissed, a subsequent Escape press resets the dismissal state back to normal.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2- Dismissal State Toggle: If no suggestion is present but the line is already marked \nas dismissed, a subsequent Escape press resets the dismissal state back to normal.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l6pOFA4kMlaaD6Uqv9Rey",
      "type": "text",
      "x": 788.0591455893646,
      "y": 4715.2329178932005,
      "width": 691.3794555664062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jft",
      "roundness": null,
      "seed": 598701475,
      "version": 827,
      "versionNonce": 1494088835,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787850478788,
      "link": null,
      "locked": false,
      "text": "3- Fallback Behavior: If neither condition matches, it returns false to \nlet CodeMirror handle the Escape key normally",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- Fallback Behavior: If neither condition matches, it returns false to \nlet CodeMirror handle the Escape key normally",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tFAiBRCtY685ATCc7jrU7",
      "type": "text",
      "x": 780.273883162474,
      "y": 3604.401091491754,
      "width": 759.7393798828125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jg",
      "roundness": null,
      "seed": 1929103715,
      "version": 621,
      "versionNonce": 633712035,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787850006606,
      "link": null,
      "locked": false,
      "text": "2- Line Tracking & Dismissal: Automatically tracks the line number and resets \nthe dismissal state (isSuggestionDismissedForLine) \nwhen the user moves to a new line (e.g., pressing Enter)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2- Line Tracking & Dismissal: Automatically tracks the line number and resets \nthe dismissal state (isSuggestionDismissedForLine) \nwhen the user moves to a new line (e.g., pressing Enter)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TVX-Vcb0eVDQ3gODlTbbb",
      "type": "text",
      "x": 780.5596148868044,
      "y": 3730.4011307286405,
      "width": 826.83935546875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jgV",
      "roundness": null,
      "seed": 852120269,
      "version": 707,
      "versionNonce": 551506861,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787850037805,
      "link": null,
      "locked": false,
      "text": "3- Debouncing & Abort Control: Clears any pending debounceTimer and cancels stale \nnetwork requests using an AbortController \nbefore dispatching a new request after a 700ms pause.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- Debouncing & Abort Control: Clears any pending debounceTimer and cancels stale \nnetwork requests using an AbortController \nbefore dispatching a new request after a 700ms pause.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0u1XzJX987kSRTXS3KjyY",
      "type": "text",
      "x": 781.1310783354651,
      "y": 3868.686882071414,
      "width": 733.6195068359375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jgl",
      "roundness": null,
      "seed": 126183555,
      "version": 759,
      "versionNonce": 174221869,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787850068436,
      "link": null,
      "locked": false,
      "text": "4- destroy(): Cleans up active timeouts and aborts ongoing requests when \nthe editor view is unmounted to prevent memory leaks.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4- destroy(): Cleans up active timeouts and aborts ongoing requests when \nthe editor view is unmounted to prevent memory leaks.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EJ5NIdVjsvWC8bQHJtF93",
      "type": "text",
      "x": 784.9402243083073,
      "y": 2716.001051818902,
      "width": 838.5594482421875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jh",
      "roundness": null,
      "seed": 470634868,
      "version": 520,
      "versionNonce": 1197838924,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "2- Check Suggestion State: Read the current suggestion value from suggestionState.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2- Check Suggestion State: Read the current suggestion value from suggestionState.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6lvFruzwhhqglqfNkHbgQ",
      "type": "text",
      "x": 784.9402243083073,
      "y": 2784.6010274048394,
      "width": 694.01953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5jj",
      "roundness": null,
      "seed": 672690508,
      "version": 564,
      "versionNonce": 1679124684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "3- Fallback if Empty: If no suggestion exists, \nreturn false to let the editor perform its default indentation behavior.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- Fallback if Empty: If no suggestion exists, \nreturn false to let the editor perform its default indentation behavior.",
