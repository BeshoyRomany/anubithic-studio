      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "4- Get Cursor Position: Locate the primary cursor head position \nin the editor view.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4- Get Cursor Position: Locate the primary cursor head position \nin the editor view.",
