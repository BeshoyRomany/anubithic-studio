      "boundElements": [],
      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "4- Rebuild if Needed: If any condition is true, call build() to \nfetch the current state and cursor position.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4- Rebuild if Needed: If any condition is true, call build() to \nfetch the current state and cursor position.",
