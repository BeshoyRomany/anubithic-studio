    },
    {
      "id": "_3QGWePtUh3qDPNIgFiwd",
      "type": "text",
      "x": 722.7072560914504,
      "y": 10474.897949164653,
      "width": 976.459228515625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErz",
      "roundness": null,
      "seed": 198738282,
      "version": 691,
      "versionNonce": 52882998,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787932351939,
      "link": null,
      "locked": false,
      "text": "1- Trigger via Keymap (Mod-K): The user selects a portion of code in the editor and presses Mod-K.\n   The quickEditKeymap intercepts this shortcut, checks if a text selection exists, \n    and dispatches the showQuickEditEffect with a value of true.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- Trigger via Keymap (Mod-K): The user selects a portion of code in the editor and presses Mod-K.\n   The quickEditKeymap intercepts this shortcut, checks if a text selection exists, \n    and dispatches the showQuickEditEffect with a value of true.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ckQ3sWZvx__8Rkqhbewi1",
      "type": "text",
      "x": 719.6241587989974,
      "y": 10581.276792503353,
      "width": 762.299560546875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzV",
      "roundness": null,
      "seed": 1468675498,
      "version": 753,
      "versionNonce": 1826856374,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787932407648,
      "link": null,
      "locked": false,
      "text": "2- State & Tooltip Management: The quickEditState tracks visibility status, \n    while quickEditTooltipField listens to transactions, doc changes, \n    and effects to generate or clear the tooltip.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2- State & Tooltip Management: The quickEditState tracks visibility status, \n    while quickEditTooltipField listens to transactions, doc changes, \n    and effects to generate or clear the tooltip.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b53zVKzc4t7vmilZ0n_zY",
      "type": "text",
      "x": 723.5187400134822,
      "y": 10698.122087058386,
      "width": 961.3792724609375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzl",
      "roundness": null,
      "seed": 1942625834,
      "version": 820,
      "versionNonce": 1046063990,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787932435770,
      "link": null,
      "locked": false,
      "text": "3- DOM Widget Creation (createQuickEditTooltip): When active, \n    a floating UI element is rendered near the selection. It builds a form containing an input field, \n    a Cancel button, and a Submit button.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- DOM Widget Creation (createQuickEditTooltip): When active, \n    a floating UI element is rendered near the selection. It builds a form containing an input field, \n    a Cancel button, and a Submit button.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XOY-n1C5TjDhL8sm3u2kB",
      "type": "text",
      "x": 724.2098480607655,
      "y": 11075.106498344237,
      "width": 859.1195068359375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzp",
      "roundness": null,
      "seed": 1838433334,
      "version": 911,
      "versionNonce": 1502235178,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787932528373,
      "link": null,
      "locked": false,
      "text": "5- Applying Changes: Upon receiving a valid editedCode response from the AI, \n    the editor dispatches a transaction to replace the old selection with the new code, \n    updates the cursor position, and hides the tooltip widget.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5- Applying Changes: Upon receiving a valid editedCode response from the AI, \n    the editor dispatches a transaction to replace the old selection with the new code, \n    updates the cursor position, and hides the tooltip widget.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kDKiGDF-LXv1yNc1V5TIf",
      "type": "text",
      "x": 734.7366756644027,
      "y": 11732.53807497182,
      "width": 764.91943359375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzr",
      "roundness": null,
      "seed": 996901686,
      "version": 1014,
      "versionNonce": 713232106,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787949120290,
      "link": null,
      "locked": false,
      "text": "1- Code Selection: \nThe process begins when the user highlights or selects text inside the editor.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- Code Selection: \nThe process begins when the user highlights or selects text inside the editor.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CukBlbj6N1J8156ggCdBf",
      "type": "text",
      "x": 737.9685170079163,
      "y": 11822.873100385199,
      "width": 975.119384765625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzs",
      "roundness": null,
      "seed": 1333917494,
      "version": 1059,
      "versionNonce": 12153654,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787949137706,
      "link": null,
      "locked": false,
      "text": "2- State Check: \nThe system checks both the text selection and whether the Quick Edit feature is currently active.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2- State Check: \nThe system checks both the text selection and whether the Quick Edit feature is currently active.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CAnOfSvOXQe5OYVc7nNsV",
      "type": "text",
      "x": 735.3151006102207,
      "y": 11908.499852253153,
      "width": 978.559326171875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzsV",
      "roundness": null,
      "seed": 867680426,
      "version": 1091,
      "versionNonce": 1253679338,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787949152570,
      "link": null,
      "locked": false,
      "text": "3- Suppressing Tooltip: \nIf the selection is empty or Quick Edit is already open, the tooltip is hidden to avoid visual clutter.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- Suppressing Tooltip: \nIf the selection is empty or Quick Edit is already open, the tooltip is hidden to avoid visual clutter.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KA45sh2fzjMWKGhtKjgUS",
      "type": "text",
      "x": 733.8386459574903,
      "y": 11994.595359673105,
      "width": 734.7994995117188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzsl",
      "roundness": null,
      "seed": 942277942,
      "version": 1140,
      "versionNonce": 2024110954,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787949187290,
      "link": null,
      "locked": false,
      "text": "4- Building the Tooltip: \nIf the selection is valid, the tooltip interface and its buttons are created.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4- Building the Tooltip: \nIf the selection is valid, the tooltip interface and its buttons are created.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ibkXIbTyA_2rGhAWdthcv",
      "type": "text",
      "x": 735.8935255560388,
      "y": 12092.287047066273,
      "width": 730.223388671875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzst",
      "roundness": null,
      "seed": 1546803946,
      "version": 1203,
      "versionNonce": 1063865962,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787949204578,
      "link": null,
      "locked": false,
      "text": "5- OS Shortcut Detection: \nThe system automatically detects the user's operating system to display \nthe correct keyboard shortcut (⌘K for Mac or Ctrl+K for Windows/Linux).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5- OS Shortcut Detection: \nThe system automatically detects the user's operating system to display \nthe correct keyboard shortcut (⌘K for Mac or Ctrl+K for Windows/Linux).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nlYf1Mp6-_E885lbt96dp",
      "type": "text",
      "x": 735.5941673531885,
      "y": 12206.163440206776,
      "width": 834.8594360351562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzsx",
      "roundness": null,
      "seed": 714952630,
      "version": 1268,
      "versionNonce": 486020278,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787949224014,
      "link": null,
      "locked": false,
      "text": "6- Click Action Binding: \nClicking the Quick Edit button triggers an effect update to change the editor state.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6- Click Action Binding: \nClicking the Quick Edit button triggers an effect update to change the editor state.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YODPLXA0BbUb3QGkB_c5t",
      "type": "text",
      "x": 732.7636096039744,
      "y": 12295.498443169336,
      "width": 849.2794189453125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzsz",
      "roundness": null,
      "seed": 487741226,
      "version": 1323,
      "versionNonce": 1632143606,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787949241042,
      "link": null,
      "locked": false,
      "text": "7- Final Extension Export: \nAll components are bundled together and exported as a ready-to-use editor extension.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7- Final Extension Export: \nAll components are bundled together and exported as a ready-to-use editor extension.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jQywt63BsXNaMAsfqmbO5",
      "type": "text",
      "x": 720.6295680384567,
      "y": 10834.865966584684,
      "width": 870.3593139648438,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCErzt",
      "roundness": null,
      "seed": 103693418,
      "version": 908,
      "versionNonce": 898447478,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787932498841,
      "link": null,
      "locked": false,
      "text": "4- Execution & Fetching:\n\n    - Clicking Cancel triggers an AbortController to cancel any pending network request \n      and closes the quick edit widget.\n\n    - Clicking Submit captures the selected code, full file context, and user instructions, \n      disables the submit button, initializes an AbortSignal, and calls the backend fetcher.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4- Execution & Fetching:\n\n    - Clicking Cancel triggers an AbortController to cancel any pending network request \n      and closes the quick edit widget.\n\n    - Clicking Submit captures the selected code, full file context, and user instructions, \n      disables the submit button, initializes an AbortSignal, and calls the backend fetcher.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9JAYWdryQqDpxoFdQXMmO",
      "type": "text",
      "x": 736.3369664106364,
      "y": 9349.419335738443,
      "width": 1032.3992919921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCEs",
      "roundness": null,
      "seed": 306567530,
      "version": 424,
      "versionNonce": 582266090,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787916042372,
      "link": null,
      "locked": false,
      "text": "6- Response: The AI returns the final editedCode, which is sent back to the client to update the editor.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6- Response: The AI returns the final editedCode, which is sent back to the client to update the editor.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XfNLBdQ-eZ07s6Yv-Lowr",
      "type": "text",
      "x": 741.6703200890217,
      "y": 8936.752669071777,
      "width": 823.7794799804688,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCEt",
      "roundness": null,
      "seed": 1809857642,
      "version": 229,
      "versionNonce": 97108650,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787915976997,
      "link": null,
      "locked": false,
      "text": "3- Authorization Branch:\n    - If the user is not authorized, it immediately returns a 400 Bad Request error \n      and terminates the request.\n\n    - If the user is authorized, the flow continues.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- Authorization Branch:\n    - If the user is not authorized, it immediately returns a 400 Bad Request error \n      and terminates the request.\n\n    - If the user is authorized, the flow continues.",
      "autoResize": true,
      "lineHeight": 1.25
    },
