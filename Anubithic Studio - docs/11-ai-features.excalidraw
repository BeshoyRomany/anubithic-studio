    {
      "id": "nUShYwwP9kM-fgGSKOkNw",
      "type": "text",
      "x": 779.140114445026,
      "y": 750.0430287906688,
      "width": 853.4193725585938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
