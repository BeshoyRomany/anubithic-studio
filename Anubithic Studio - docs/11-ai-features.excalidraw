      "isDeleted": false,
      "boundElements": [],
      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "5- Dispatch Transaction: Execute view.dispatch to insert the text, \nupdate the selection anchor, and clear the active suggestion state effect.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5- Dispatch Transaction: Execute view.dispatch to insert the text, \nupdate the selection anchor, and clear the active suggestion state effect.",
