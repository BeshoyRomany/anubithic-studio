      "updated": 1787657620156,
      "link": null,
      "locked": false,
      "text": "3-Check Triggers: Evaluate three conditions \n(docChanged, selectionSet, or suggestionChanged) to see if a refresh is needed.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3-Check Triggers: Evaluate three conditions \n(docChanged, selectionSet, or suggestionChanged) to see if a refresh is needed.",
