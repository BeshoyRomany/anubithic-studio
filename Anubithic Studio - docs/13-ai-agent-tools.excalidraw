      "type": "text",
      "x": 754.796258842101,
      "y": 1764.3459250552596,
      "width": 1204.439208984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
