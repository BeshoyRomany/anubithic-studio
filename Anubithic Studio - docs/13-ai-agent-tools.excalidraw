      "isDeleted": false,
      "boundElements": [],
      "updated": 1788519678760,
      "link": null,
      "locked": false,
      "text": "1- User Request & Validation: \nThe user submits a message from the frontend, which triggers the Next.js API route (/api/messages).\nThe route validates user authentication (Clerk) and checks the system internal key.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- User Request & Validation: \nThe user submits a message from the frontend, which triggers the Next.js API route (/api/messages).\nThe route validates user authentication (Clerk) and checks the system internal key.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SOZllJbqXP1-cOoKXS3XY",
      "type": "text",
      "x": 755.7962181519971,
      "y": 1678.6792583885929,
      "width": 1434.218994140625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
